<Window x:Class="PadPilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BigKev" Icon="Assets/BigKev.ico" Background="#0B0D12" Width="1240" Height="800" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Grid Background="#0B0D12"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="#10131A" BorderBrush="#242A36" BorderThickness="0,0,0,1" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="52" Height="52" CornerRadius="13" ClipToBounds="True"><Image Source="Assets/BigKev.png" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="14,3,0,0"><TextBlock Text="BigKev" FontSize="25" FontWeight="Bold"/><TextBlock Text="DualSense control, without the clutter" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel><Border Grid.Column="2" Background="#192820" CornerRadius="12" Padding="14,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#62E6A3" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionLabel" Text="Looking for a wired DualSense…" Foreground="#8CEBB8"/></StackPanel></Border></Grid></Border>
    <Border Grid.Row="1" Background="#10131A" BorderBrush="#242A36" BorderThickness="0,0,1,0" Padding="16,22"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="＋  New profile" Style="{StaticResource PrimaryButton}" Click="NewProfile_Click"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Duplicate" Click="DuplicateProfile_Click"/><Button Grid.Column="1" Content="Delete" Click="DeleteProfile_Click"/></Grid><Button Content="Import profiles…" Click="ImportProfiles_Click"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Export selected…" Click="ExportProfile_Click"/><Button Grid.Column="1" Content="Export all…" Click="ExportAll_Click"/></Grid></StackPanel><StackPanel><TextBlock Text="YOUR PROFILES" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/><ListBox x:Name="ProfilesList" DisplayMemberPath="Name" SelectionChanged="ProfilesList_SelectionChanged"/></StackPanel></DockPanel></Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><Grid Margin="26,20,26,14" MinWidth="680" MinHeight="500" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18,12" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LIVE INPUT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LiveInputLabel" Text="Connect your controller to preview inputs" FontSize="15" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal"><StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="USB-C → PS5" Foreground="#A78BFA" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Margin="0,4,0,0"><Hyperlink NavigateUri="https://github.com/hifihedgehog/HIDMaestro/releases/latest" RequestNavigate="DriverLink_RequestNavigate" Foreground="#9FB7FF" TextDecorations="Underline">Official driver page</Hyperlink></TextBlock></StackPanel><Button x:Name="DriverInstallButton" Content="Install DualSense driver" Style="{StaticResource PrimaryButton}" Click="InstallDriver_Click"/></StackPanel></Grid></Border>
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22"><TabControl>
        <TabItem Header="Mappings"><Grid Margin="4,18,4,4" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Profile name" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Row="1" x:Name="ProfileName" FontSize="17" TextChanged="ProfileName_TextChanged"/><DataGrid Grid.Row="2" x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="True" Margin="4,16" MinHeight="280" HorizontalAlignment="Stretch"><DataGrid.Columns><DataGridTextColumn Header="DualSense input" Binding="{Binding Source}" Width="*"/><DataGridComboBoxColumn x:Name="MappingKindColumn" Header="Action" SelectedItemBinding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Output or macro name" Binding="{Binding Target}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Save profile" Style="{StaticResource PrimaryButton}" Click="Save_Click"/><TextBlock Text="Use the exact macro name when Action is Macro." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/></StackPanel></Grid></TabItem>
        <TabItem Header="Macros"><Grid Margin="4,18,4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SAVED MACROS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="6"/><ListBox x:Name="MacrosList" DisplayMemberPath="Name" SelectionChanged="MacrosList_SelectionChanged" Height="350"/><Button Content="＋  New macro" Style="{StaticResource PrimaryButton}" Click="NewMacro_Click"/></StackPanel><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0"><TextBlock Text="Macro name" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MacroName"/><TextBlock Text="Trigger button" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0"/><ComboBox x:Name="MacroTriggerInput" Width="230" HorizontalAlignment="Left" Style="{StaticResource MacroComboBoxStyle}"/><CheckBox x:Name="MacroRepeat" Content="Repeat this sequence while the trigger button is held" Margin="6,10"/><ListBox x:Name="StepsList" Height="230" Margin="4,12" Background="#10131A"/><TextBlock Text="Add action" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Choose a button, then press Press or Release. Use Wait to control timing." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,4"/><WrapPanel><ComboBox x:Name="MacroControlInput" Width="230" Style="{StaticResource MacroComboBoxStyle}"/><TextBox x:Name="MacroDelayInput" Width="90" Text="50" ToolTip="Delay in milliseconds"/><Button Content="Press" Click="AddPress_Click"/><Button Content="Release" Click="AddRelease_Click"/><Button Content="Wait" Click="AddWait_Click"/></WrapPanel><WrapPanel><Button Content="Remove selected" Click="RemoveStep_Click"/><Button Content="Import macro…" Click="ImportMacro_Click"/><Button Content="Export macro…" Click="ExportMacro_Click"/><Button Content="Save macro" Style="{StaticResource PrimaryButton}" Click="SaveMacro_Click"/></WrapPanel><TextBlock x:Name="MacroMessage" Foreground="#FF9A9A" Margin="6" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></TabItem>
        <TabItem Header="Controller test"><Grid Margin="8,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Live DualSense test" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Visualization is off by default so it cannot use interface resources during gameplay." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/><Button x:Name="ControllerTestButton" Content="Start controller test" Click="ToggleControllerTest_Click" HorizontalAlignment="Left"/></StackPanel><Viewbox Grid.Row="1" Stretch="Uniform"><Canvas Width="660" Height="440"><Image Source="Assets/DualSenseTestAngled.png" Width="660" Height="440" Stretch="Uniform"/><Border x:Name="VizL1" Canvas.Left="132" Canvas.Top="76" Width="74" Height="34" CornerRadius="17" Background="Transparent"/><Border x:Name="VizR1" Canvas.Left="454" Canvas.Top="76" Width="74" Height="34" CornerRadius="17" Background="Transparent"/><Border x:Name="VizDpadUp" Canvas.Left="145" Canvas.Top="156" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizDpadLeft" Canvas.Left="120" Canvas.Top="181" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizDpadRight" Canvas.Left="170" Canvas.Top="181" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizDpadDown" Canvas.Left="145" Canvas.Top="206" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizTriangle" Canvas.Left="473" Canvas.Top="145" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizSquare" Canvas.Left="438" Canvas.Top="180" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizCircle" Canvas.Left="510" Canvas.Top="180" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizCross" Canvas.Left="473" Canvas.Top="215" Width="38" Height="38" CornerRadius="19" Background="Transparent"/><Border x:Name="VizCreate" Canvas.Left="196" Canvas.Top="127" Width="28" Height="28" CornerRadius="14" Background="Transparent"/><Border x:Name="VizOptions" Canvas.Left="436" Canvas.Top="127" Width="28" Height="28" CornerRadius="14" Background="Transparent"/><Border x:Name="VizPS" Canvas.Left="312" Canvas.Top="235" Width="36" Height="36" CornerRadius="18" Background="Transparent"/><Ellipse x:Name="VizL3" Canvas.Left="219" Canvas.Top="237" Width="50" Height="50" Fill="Transparent"/><Ellipse x:Name="VizR3" Canvas.Left="387" Canvas.Top="237" Width="50" Height="50" Fill="Transparent"/><TextBlock x:Name="VizStickValues" Canvas.Left="235" Canvas.Top="410" Width="190" Text="Sticks waiting for input" TextAlignment="Center" Foreground="#E4E7EF" Background="#AA111318"/></Canvas></Viewbox></Grid></TabItem>
        <TabItem Header="Stick tuning"><StackPanel Margin="8,28" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="Fine-tune your sticks" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Increase a dead zone only when a stick moves by itself." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,28"/><CheckBox x:Name="LeftDeadZoneEnabled" Content="Apply BigKev left-stick dead zone" Checked="StickDeadZoneCheckBox_Changed" Unchecked="StickDeadZoneCheckBox_Changed"/><Slider x:Name="LeftDeadZone" Minimum="0" Maximum="0.4" TickFrequency="0.01" Margin="0,12,0,30" ValueChanged="StickTuningSlider_ValueChanged"/><CheckBox x:Name="RightDeadZoneEnabled" Content="Apply BigKev right-stick dead zone" Checked="StickDeadZoneCheckBox_Changed" Unchecked="StickDeadZoneCheckBox_Changed"/><Slider x:Name="RightDeadZone" Minimum="0" Maximum="0.4" TickFrequency="0.01" Margin="0,12,0,30" ValueChanged="StickTuningSlider_ValueChanged"/><TextBlock Text="Game-facing controller" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/><TextBlock Text="Choose which virtual controller games will detect." Foreground="#B8C0CF" FontSize="12" Margin="0,4,0,0"/><ComboBox x:Name="OutputModeInput" Width="320" MinHeight="44" HorizontalAlignment="Left" Margin="0,12,0,24" Style="{StaticResource MacroComboBoxStyle}" SelectionChanged="OutputModeInput_SelectionChanged"/><CheckBox x:Name="L2DownAssistEnabled" Content="Hold L2 + R2: nudge right stick down" Margin="0,0,0,10" Checked="StickTuningCheckBox_Changed" Unchecked="StickTuningCheckBox_Changed"/><TextBlock Text="How far down (0 = center, 0.5 = full down)" FontSize="13" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="L2DownAssistAmount" Minimum="0" Maximum="0.5" TickFrequency="0.01" Margin="0,12,0,30" ValueChanged="StickTuningSlider_ValueChanged"/><Button Content="Save tuning" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Save_Click"/></StackPanel></TabItem>
        <TabItem Header="About &amp; updates"><StackPanel Margin="8,28" MaxWidth="650" HorizontalAlignment="Left"><TextBlock Text="About BigKev" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Text="Installed version" FontSize="16" Margin="0,14,0,6"/><TextBlock Text="Updates are downloaded only from the official thefactory182-arch/BigKev GitHub releases." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/><Button x:Name="CheckForUpdatesButton" Content="Check for updates" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CheckForUpdates_Click"/><TextBlock x:Name="UpdateMessage" Text="Click the button to check for a newer version." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,14,0,0"/></StackPanel></TabItem>
      </TabControl></Border></Grid></ScrollViewer>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#10131A" BorderBrush="#242A36" BorderThickness="0,1,0,0" Padding="24,0"><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Border>
  </Grid>
</Window>


